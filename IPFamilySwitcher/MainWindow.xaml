<Window x:Class="IPFamilySwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:IPFamilySwitcher.Models"
        Title="IP Family Switcher"
        Height="620"
        Width="1050"
        MinHeight="480"
        MinWidth="980"
        Background="#F7F8FA"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Refresh" ToolTip="Refresh firewall state and application statuses" Command="{Binding RefreshCommand}"/>
                <Button Content="＋ Add Application" ToolTip="Add an executable to IP Family Switcher" Command="{Binding AddApplicationCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="IP Family Switcher" FontSize="26" FontWeight="SemiBold" Foreground="#18212F"/>
                <TextBlock Text="Per-application IPv4 and IPv6 controls" Foreground="#657083" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1"
                Padding="10,8"
                Margin="0,0,0,12"
                Background="#E8F5E9"
                BorderBrush="#A5D6A7"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock Text="{Binding AdministratorStatus}"
                       Foreground="#1B5E20"
                       FontWeight="SemiBold"/>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8" MinWidth="260"/>
        </DockPanel>
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding FilteredApplications}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="88"
                  Margin="0,0,0,14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" IsReadOnly="True" Width="1.2*"/>
                <DataGridTextColumn Header="Executable" Binding="{Binding ExecutablePath}" IsReadOnly="True" Width="2*"/>
                <DataGridTemplateColumn Header="Network mode" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding DataContext.Modes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding PendingMode, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Apply"
                                        ToolTip="Apply the selected network mode and update its firewall rule"
                                        Command="{Binding DataContext.ApplyModeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding HasPendingModeChange, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="130"/>
                <DataGridTemplateColumn Header="Actions" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel>
                                <Button Content="Repair" ToolTip="Recreate or correct this application's managed firewall rule" Command="{Binding DataContext.RepairApplicationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="Locate" ToolTip="Choose a new executable path while keeping this application identity" Command="{Binding DataContext.LocateApplicationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="Remove" ToolTip="Remove this application and its managed firewall rule" Command="{Binding DataContext.RemoveApplicationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding Summary}" Foreground="#4B5565" Margin="0,0,0,12"/>
        <DockPanel Grid.Row="5">
            <DockPanel>
                <Button Content="Copy error"
                        DockPanel.Dock="Right"
                        ToolTip="Copy the current error message to the clipboard"
                        Click="CopyError"
                        Margin="8,4,4,4"/>
                <TextBox Text="{Binding ErrorMessage}"
                         IsReadOnly="True"
                         IsTabStop="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#B42318"
                         VerticalAlignment="Center"
                         MaxWidth="620"
                         ToolTip="Select and copy this error text, or use Copy error."/>
            </DockPanel>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Enable All" ToolTip="Enable all managed firewall rules without deleting them" Command="{Binding EnableAllCommand}"/>
                <Button Content="Disable All" ToolTip="Disable all managed firewall rules while keeping configuration" Command="{Binding DisableAllCommand}"/>
                <Button Content="Repair All" ToolTip="Repair managed rules for all configured restricted applications" Command="{Binding RepairAllCommand}"/>
                <Button Content="Remove All Rules" ToolTip="Delete only IP Family Switcher's managed firewall rules" Command="{Binding RemoveAllRulesCommand}"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
