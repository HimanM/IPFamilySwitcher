<Window x:Class="IPFamilySwitcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="IP Family Switcher" Icon="Resources/app.ico" Width="1180" Height="800" MinWidth="1020" MinHeight="720"
 Background="#E4E8DA" Foreground="#252923" FontFamily="/IPFamilySwitcher;component/Resources/Fonts/#Rajdhani" FontWeight="SemiBold" FontSize="16"
 UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/IPFamilySwitcher;component/Resources/Fonts/#Rajdhani</FontFamily>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#F4F6EE"/><Setter Property="Foreground" Value="#242823"/>
   <Setter Property="BorderBrush" Value="#929B87"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="0"/>
   <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="36"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <Border x:Name="Signal" Width="3" HorizontalAlignment="Left" Margin="0,4" Background="#FF6900" Opacity="0"/>
     <Path x:Name="Corner" Data="M0,7 L7,0 L7,7 Z" Fill="#FF6900" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3" Opacity="0.65"/>
     <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="#FF6900" Margin="3" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DFFF00"/><Setter Property="Foreground" Value="#242823"/><Setter TargetName="Signal" Property="Opacity" Value="1"/><Setter TargetName="Corner" Property="Opacity" Value="1"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FF6900"/><Setter Property="Foreground" Value="#171A15"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#252923"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="#252923"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#252923"/><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Background" Value="#F4F6EE"/><Setter Property="Foreground" Value="#252923"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E5F7A4"/><Setter Property="Foreground" Value="#252923"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Border Background="#DCE1D2" Padding="2">
     <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton x:Name="Back" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinHeight="12" MinWidth="8"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#727D67"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#424D37"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#FF6900"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton x:Name="Forward" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Back" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Forward" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Badge" TargetType="Border"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#FDE1DE"/><Setter Property="BorderBrush" Value="#DC5149"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers>
   <DataTrigger Binding="{Binding Status}" Value="Active"><Setter Property="Background" Value="#DFFF00"/><Setter Property="BorderBrush" Value="#768500"/></DataTrigger>
   <DataTrigger Binding="{Binding Status}" Value="Default"><Setter Property="Background" Value="#E7EBF4"/><Setter Property="BorderBrush" Value="#A2AEC5"/></DataTrigger>
   <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Background" Value="#F5EBC5"/><Setter Property="BorderBrush" Value="#B4A268"/></DataTrigger>
  </Style.Triggers></Style>
 </Window.Resources>
 <Grid Background="#E4E8DA">
  <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
  <Border Background="#252923" BorderBrush="#DFFF00" BorderThickness="0,0,0,3" Padding="24,12">
   <DockPanel><StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Text="{Binding VersionLabel}" Foreground="#DFFF00" HorizontalAlignment="Right"/><TextBlock Text="PER-APP / PERSISTENT" Foreground="#BBC6AF" FontSize="13"/></StackPanel>
    <Image Source="Resources/app-icon.png" Width="48" Height="48" Margin="0,0,16,0" DockPanel.Dock="Left"/>
    <StackPanel VerticalAlignment="Center"><TextBlock FontSize="32" FontWeight="Bold" Foreground="White"><Run Text="IP FAMILY "/><Run Text="SWITCHER" Foreground="#DFFF00"/></TextBlock><TextBlock Text="One application. One IP family. Your choice." Foreground="#BBC6AF" FontSize="14"/></StackPanel>
   </DockPanel>
  </Border>
  <UniformGrid Grid.Row="1" Columns="3" Margin="24,12,24,0">
   <Border BorderBrush="#939E88" BorderThickness="1" Padding="14,4"><DockPanel><TextBlock Text="{Binding ApplicationCount}" FontSize="30" FontWeight="Bold" DockPanel.Dock="Right"/><TextBlock Text="01 / MANAGED APPLICATIONS" VerticalAlignment="Center"/></DockPanel></Border>
   <Border BorderBrush="#939E88" BorderThickness="0,1,1,1" Background="#DFFF00" Padding="14,4"><DockPanel><TextBlock Text="{Binding ActiveCount}" FontSize="30" FontWeight="Bold" DockPanel.Dock="Right"/><TextBlock Text="02 / ENABLED RULES" VerticalAlignment="Center"/></DockPanel></Border>
   <Border BorderBrush="#939E88" BorderThickness="0,1,1,1" Padding="14,4"><DockPanel><TextBlock Text="{Binding IssueCount}" FontSize="30" FontWeight="Bold" DockPanel.Dock="Right"/><TextBlock Text="03 / NEED ATTENTION" VerticalAlignment="Center"/></DockPanel></Border>
  </UniformGrid>
  <Grid Grid.Row="2" Margin="24,12,24,10">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="50"/><RowDefinition Height="88"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh" Width="144" Margin="0,0,8,0" Command="{Binding RefreshCommand}" ToolTip="Recheck firewall state"/><Button Content="+ Add application" Width="144" Background="#252923" Foreground="#DFFF00" Command="{Binding AddApplicationCommand}" IsEnabled="{Binding IsAdministrator}"/></StackPanel>
    <TextBlock DockPanel.Dock="Left" Text="SEARCH" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left" Padding="8,4" BorderBrush="#939E88" BorderThickness="1" Background="#F4F6EE" AutomationProperties.Name="Search applications"/>
   </DockPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="262"/></Grid.ColumnDefinitions>
    <Grid>
     <DataGrid x:Name="ApplicationsGrid" ItemsSource="{Binding FilteredApplications}" SelectedItem="{Binding SelectedApplication, Mode=TwoWay}"
       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" IsReadOnly="True"
       HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#CDD3C4" BorderBrush="#939E88" BorderThickness="1" Background="#F4F6EE"
       RowHeight="56" SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="APPLICATION" Width="*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" Foreground="#252923" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ExecutablePath}" Foreground="#59634E" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="104"/>
       <DataGridTemplateColumn Header="FIREWALL" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Badge}" Padding="6,2" ToolTip="{Binding StatusDetail}"><TextBlock Text="{Binding Status}" Foreground="#252923" FontSize="14" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="PROCESS" Width="108"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RunningStatus}" FontSize="15"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#59634E"/><Style.Triggers><DataTrigger Binding="{Binding RunningStatus}" Value="Running"><Setter Property="Foreground" Value="#245AAA"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="No matching applications.
Add an executable or clear your search." TextAlignment="Center" VerticalAlignment="Center" Foreground="#59634E" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ApplicationsGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Border Grid.Column="2" Background="#F4F6EE" BorderBrush="#939E88" BorderThickness="1">
     <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#252923" Padding="12,8"><TextBlock Text="SELECTED APPLICATION" Foreground="#DFFF00" FontSize="14"/></Border>
      <TextBlock Grid.Row="1" Text="Select an application from the list to manage its rule." TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" TextAlignment="Center" Foreground="#59634E"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedApplication}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel x:Name="SelectedActions" Margin="12" DataContext="{Binding SelectedApplication}"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/>
        <TextBlock Text="{Binding StatusDetail}" FontSize="14" Foreground="#59634E" TextWrapping="Wrap" MaxHeight="40" Margin="0,0,0,8"/>
        <StackPanel IsEnabled="{Binding DataContext.IsAdministrator, RelativeSource={RelativeSource AncestorType=Window}}">
         <TextBlock Text="NETWORK MODE" FontSize="13" Margin="0,0,0,4"/>
         <ComboBox Height="34" Padding="6,3" ItemsSource="{Binding DataContext.Modes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding PendingMode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Selected application network mode"/>
         <Button x:Name="ApplySelection" Content="Apply change" Margin="0,8,0,0" Background="#DFFF00" IsEnabled="{Binding HasPendingModeChange}" Command="{Binding DataContext.ApplyModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
         <TextBlock Text="Choose a mode, then apply." FontSize="13" Foreground="#59634E" Margin="0,4,0,8"/>
         <Grid x:Name="RecordActions"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="8"/><RowDefinition Height="36"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Content="{Binding ToggleLabel}" Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Default"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Grid.Column="2" Content="Repair" Command="{Binding DataContext.RepairApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
          <Button Grid.Row="2" Content="Locate" Command="{Binding DataContext.LocateApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
          <Button Grid.Row="2" Grid.Column="2" Content="Remove" Foreground="#A52C21" Command="{Binding DataContext.RemoveApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
         </Grid>
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Border>
   </Grid>
   <DockPanel Grid.Row="2" Margin="0,10,0,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsAdministrator}">
    <Button Content="Enable all" Width="132" Margin="0,0,8,0" Command="{Binding EnableAllCommand}"/><Button Content="Disable all" Width="132" Margin="0,0,8,0" Command="{Binding DisableAllCommand}"/><Button Content="Repair all" Width="132" Margin="0,0,8,0" Command="{Binding RepairAllCommand}"/><Button Content="Remove all rules" Width="132" Foreground="#A52C21" Command="{Binding RemoveAllRulesCommand}"/>
   </StackPanel><TextBlock Text="ALL APPLICATIONS" FontSize="13" VerticalAlignment="Center" Foreground="#59634E"/></DockPanel>
   <Border x:Name="ErrorPanel" Grid.Row="3" Height="78" Margin="0,10,0,0" Padding="12,8" BorderThickness="3,0,0,0" ClipToBounds="True">
    <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FF6900"/><Setter Property="Background" Value="#F8E4D3"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="BorderBrush" Value="#899180"/><Setter Property="Background" Value="#E4E8DA"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="STATUS / DETAILS"  FontSize="12" Foreground="#703200"/>
      <TextBlock Grid.Row="1" Text="No errors. Ready for your next change." Foreground="#5D6556" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBox x:Name="ErrorText" Grid.Row="1" Text="{Binding ErrorMessage, Mode=OneWay}" AutomationProperties.Name="Error details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Foreground="#812C10"/>
     </Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Button Content="Copy error" Width="100" Margin="0,0,8,0" Click="CopyError" Padding="10,4" ToolTip="Copy the complete error message"/>
      <Button Content="Dismiss" Width="100" Click="DismissError" Padding="10,4" Margin="0" ToolTip="Dismiss this message without changing firewall rules"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#252923" Padding="24,8"><DockPanel>
   <Button DockPanel.Dock="Right" Click="OpenRepository" Background="#252923" Foreground="White" BorderBrush="#727D67" Width="112" ToolTip="Open the GitHub repository"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,8,0"><Path Fill="White" Data="M12,0 C5.37,0 0,5.37 0,12 C0,17.3 3.44,21.8 8.21,23.39 C8.81,23.5 9.03,23.13 9.03,22.81 L9.01,20.58 C5.67,21.31 4.97,19.16 4.97,19.16 C4.42,17.77 3.63,17.4 3.63,17.4 C2.54,16.65 3.71,16.67 3.71,16.67 C4.91,16.75 5.54,17.9 5.54,17.9 C6.61,19.73 8.35,19.2 9.04,18.89 C9.15,18.11 9.46,17.58 9.8,17.28 C7.13,16.98 4.33,15.94 4.33,11.34 C4.33,10.03 4.8,8.96 5.57,8.12 C5.45,7.82 5.03,6.6 5.69,4.95 C5.69,4.95 6.7,4.63 8.99,6.18 C9.95,5.91 10.97,5.78 11.99,5.78 C13.01,5.78 14.03,5.91 14.99,6.18 C17.28,4.63 18.29,4.95 18.29,4.95 C18.95,6.6 18.53,7.82 18.41,8.12 C19.18,8.96 19.64,10.03 19.64,11.34 C19.64,15.95 16.84,16.97 14.17,17.27 C14.6,17.64 14.98,18.37 14.98,19.49 L14.96,22.81 C14.96,23.13 15.18,23.51 15.79,23.39 C20.56,21.8 24,17.3 24,12 C24,5.37 18.63,0 12,0 Z"/></Viewbox><TextBlock Text="GitHub ↗"/></StackPanel></Button>
   <TextBlock DockPanel.Dock="Right" Text="Made by HimanM" Foreground="#DFFF00" Margin="0,0,20,0" VerticalAlignment="Center"/>
   <TextBlock Text="{Binding AdministratorStatus}" Foreground="#D4DDCA" FontSize="13" VerticalAlignment="Center"/>
  </DockPanel></Border>
 </Grid>
</Window>
