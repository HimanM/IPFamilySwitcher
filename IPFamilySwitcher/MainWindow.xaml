<Window x:Class="IPFamilySwitcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="IP Family Switcher" Icon="Resources/app.ico" Width="1180" Height="820" MinWidth="1020" MinHeight="700"
 Background="#E4E8DA" Foreground="#252923" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/IPFamilySwitcher;component/Resources/Fonts/#Rajdhani</FontFamily>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#F4F6EE"/><Setter Property="Foreground" Value="#242823"/>
   <Setter Property="BorderBrush" Value="#929B87"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="32"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <Border x:Name="Signal" Width="3" HorizontalAlignment="Left" Margin="0,4" Background="#FF6900" Opacity="0"/>
     <Path x:Name="Corner" Data="M0,7 L7,0 L7,7 Z" Fill="#FF6900" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3" Opacity="0.65"/>
     <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="#FF6900" Margin="3" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DFFF00"/><Setter Property="Foreground" Value="#242823"/><Setter TargetName="Signal" Property="Opacity" Value="1"/><Setter TargetName="Corner" Property="Opacity" Value="1"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FF6900"/><Setter Property="Foreground" Value="#171A15"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#252923"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="#F4F6EE"/><Setter Property="Foreground" Value="#252923"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E7F1C3"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Badge" TargetType="Border"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#FDE1DE"/><Setter Property="BorderBrush" Value="#DC5149"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers>
   <DataTrigger Binding="{Binding Status}" Value="Active"><Setter Property="Background" Value="#DFFF00"/><Setter Property="BorderBrush" Value="#768500"/></DataTrigger>
   <DataTrigger Binding="{Binding Status}" Value="Default"><Setter Property="Background" Value="#E7EBF4"/><Setter Property="BorderBrush" Value="#A2AEC5"/></DataTrigger>
   <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Background" Value="#F5EBC5"/><Setter Property="BorderBrush" Value="#B4A268"/></DataTrigger>
  </Style.Triggers></Style>
 </Window.Resources>
 <Grid Background="#E4E8DA">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#252923" Padding="26,18" BorderBrush="#DFFF00" BorderThickness="0,0,0,3">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="NETWORK CONTROL   /   WINDOWS" FontFamily="Consolas" Foreground="#DFFF00" FontSize="12"/>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Image Source="Resources/app-icon.png" Width="58" Height="58" Margin="0,0,16,0"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="IP FAMILY " FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Black" Foreground="White" LineHeight="37"/><TextBlock Text="SWITCHER" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold" Foreground="#DFFF00" LineHeight="37"/></StackPanel>
     </StackPanel><TextBlock Text="Choose the IP family. Keep control of each app." Foreground="White" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><Border Background="#DFFF00" Padding="12,6" HorizontalAlignment="Right"><TextBlock Text="{Binding VersionLabel}" FontFamily="Consolas" FontWeight="Bold"/></Border>
     <TextBlock Text="04 / 06" FontFamily="{StaticResource DisplayFont}" Foreground="#DFFF00" FontSize="40" FontWeight="Black" Margin="0,8,0,0" HorizontalAlignment="Right"/>
     <TextBlock Text="PER-APP. PERSISTENT." Foreground="White" FontFamily="Consolas" HorizontalAlignment="Right"/>
    </StackPanel>
   </Grid>
  </Border>
  <UniformGrid Grid.Row="1" Columns="3" Margin="26,18,26,0">
   <Border BorderBrush="#252923" BorderThickness="1" Padding="16,10"><DockPanel><TextBlock Text="{Binding ApplicationCount}" FontSize="34" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" DockPanel.Dock="Right"/><TextBlock Text="01 / MANAGED APPS" FontFamily="Consolas" VerticalAlignment="Center"/></DockPanel></Border>
   <Border BorderBrush="#252923" BorderThickness="0,1,1,1" Background="#DFFF00" Padding="16,10"><DockPanel><TextBlock Text="{Binding ActiveCount}" FontSize="34" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" DockPanel.Dock="Right"/><TextBlock Text="02 / ENABLED RULES" FontFamily="Consolas" VerticalAlignment="Center"/></DockPanel></Border>
   <Border BorderBrush="#252923" BorderThickness="0,1,1,1" Padding="16,10"><DockPanel><TextBlock Text="{Binding IssueCount}" FontSize="34" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" DockPanel.Dock="Right"/><TextBlock Text="03 / NEED ATTENTION" FontFamily="Consolas" VerticalAlignment="Center"/></DockPanel></Border>
  </UniformGrid>
  <Grid Grid.Row="2" Margin="26,16,26,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="88"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip="Recheck installed firewall rules"/><Button Content="+ Add application" Background="#252923" Foreground="White" Margin="0" Command="{Binding AddApplicationCommand}" IsEnabled="{Binding IsAdministrator}" ToolTip="Select an executable; added in Default mode"/></StackPanel>
    <TextBlock DockPanel.Dock="Left" Text="SEARCH" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search applications" ToolTip="Search by application name or executable path" Padding="10,8" BorderBrush="#858B96" BorderThickness="1" Margin="0,0,20,0" MaxWidth="360" HorizontalAlignment="Left" Width="220"/>
   </DockPanel>
   <DataGrid x:Name="ApplicationsGrid" Grid.Row="1" ItemsSource="{Binding FilteredApplications}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#CDD1D7" BorderBrush="#252923" BorderThickness="1" Background="#F4F6EE" RowHeight="94" SelectionMode="Single">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="APPLICATION / EXECUTABLE" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
      <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="17" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding ExecutablePath}" Foreground="#606976" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/>
     </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="IP FAMILY" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel IsEnabled="{Binding DataContext.IsAdministrator, RelativeSource={RelativeSource AncestorType=Window}}">
      <ComboBox ItemsSource="{Binding DataContext.Modes, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding PendingMode, UpdateSourceTrigger=PropertyChanged}" Padding="7" AutomationProperties.Name="Network mode" ToolTip="IPv4Only blocks IPv6. IPv6Only blocks IPv4. Default removes the block."/>
      <Button Content="Apply change" Margin="0,6,0,0" Padding="6" Background="#DFFF00" Command="{Binding DataContext.ApplyModeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Visibility="{Binding HasPendingModeChange, Converter={StaticResource BoolVisibility}}"/>
     </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="FIREWALL" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Badge}" ToolTip="{Binding StatusDetail}"><TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="PROCESS" Width="122"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding RunningStatus}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#626B78"/><Style.Triggers><DataTrigger Binding="{Binding RunningStatus}" Value="Running"><Setter Property="Foreground" Value="#244CC8"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Live · every 5s" Foreground="#626B78" FontSize="10" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="ACTIONS" Width="215"><DataGridTemplateColumn.CellTemplate><DataTemplate><UniformGrid Columns="2" IsEnabled="{Binding DataContext.IsAdministrator, RelativeSource={RelativeSource AncestorType=Window}}">
      <Button Content="{Binding ToggleLabel}" Padding="8,5" Margin="0,0,6,6" Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Enable or disable this app's existing rule"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Default"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="Repair" Padding="8,5" Margin="0,0,6,6" Command="{Binding DataContext.RepairApplicationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Recreate this app's managed rule"/>
      <Button Content="Locate" Padding="8,5" Margin="0,0,6,0" Command="{Binding DataContext.LocateApplicationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Update the executable path"/>
      <Button Content="Remove" Padding="8,5" Margin="0" Command="{Binding DataContext.RemoveApplicationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Remove this entry and its managed rule"/>
     </UniformGrid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Rules stay installed when this window closes." Foreground="#606976" VerticalAlignment="Center"/><WrapPanel HorizontalAlignment="Right" IsEnabled="{Binding IsAdministrator}">
    <Button Content="Enable all" Padding="10,7" Command="{Binding EnableAllCommand}"/><Button Content="Disable all" Padding="10,7" Command="{Binding DisableAllCommand}"/><Button Content="Repair all" Padding="10,7" Command="{Binding RepairAllCommand}"/><Button Content="Remove all rules" Padding="10,7" Margin="0" Foreground="#B52030" Command="{Binding RemoveAllRulesCommand}"/>
   </WrapPanel></DockPanel>
   <Border x:Name="ErrorPanel" Grid.Row="3" Height="78" Margin="0,10,0,0" Padding="12,8" BorderThickness="3,0,0,0" ClipToBounds="True">
    <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FF6900"/><Setter Property="Background" Value="#F8E4D3"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="BorderBrush" Value="#899180"/><Setter Property="Background" Value="#E4E8DA"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="STATUS / DETAILS" FontFamily="Consolas" FontSize="10" Foreground="#703200"/>
      <TextBlock Grid.Row="1" Text="No errors. Ready for your next change." Foreground="#5D6556" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBox x:Name="ErrorText" Grid.Row="1" Text="{Binding ErrorMessage, Mode=OneWay}" AutomationProperties.Name="Error details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Foreground="#812C10"/>
     </Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Button Content="Copy error" Click="CopyError" Padding="10,4" ToolTip="Copy the complete error message"/>
      <Button Content="Dismiss" Click="DismissError" Padding="10,4" Margin="0" ToolTip="Dismiss this message without changing firewall rules"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#252923" Padding="26,12"><DockPanel>
   <Button DockPanel.Dock="Right" Click="OpenRepository" ToolTip="github.com/HimanM/IPFamilySwitcher" Background="#252923" Foreground="White" BorderBrush="#6C7481" Padding="10,5" Margin="0"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,8,0"><Path Fill="White" Data="M12,0 C5.37,0 0,5.37 0,12 C0,17.3 3.44,21.8 8.21,23.39 C8.81,23.5 9.03,23.13 9.03,22.81 L9.01,20.58 C5.67,21.31 4.97,19.16 4.97,19.16 C4.42,17.77 3.63,17.4 3.63,17.4 C2.54,16.65 3.71,16.67 3.71,16.67 C4.91,16.75 5.54,17.9 5.54,17.9 C6.61,19.73 8.35,19.2 9.04,18.89 C9.15,18.11 9.46,17.58 9.8,17.28 C7.13,16.98 4.33,15.94 4.33,11.34 C4.33,10.03 4.8,8.96 5.57,8.12 C5.45,7.82 5.03,6.6 5.69,4.95 C5.69,4.95 6.7,4.63 8.99,6.18 C9.95,5.91 10.97,5.78 11.99,5.78 C13.01,5.78 14.03,5.91 14.99,6.18 C17.28,4.63 18.29,4.95 18.29,4.95 C18.95,6.6 18.53,7.82 18.41,8.12 C19.18,8.96 19.64,10.03 19.64,11.34 C19.64,15.95 16.84,16.97 14.17,17.27 C14.6,17.64 14.98,18.37 14.98,19.49 L14.96,22.81 C14.96,23.13 15.18,23.51 15.79,23.39 C20.56,21.8 24,17.3 24,12 C24,5.37 18.63,0 12,0 Z"/></Viewbox><TextBlock Text="GitHub ↗"/></StackPanel></Button>
   <TextBlock DockPanel.Dock="Right" Text="Made by HimanM" Foreground="#DFFF00" Margin="0,0,20,0" VerticalAlignment="Center"/>
   <TextBlock Text="{Binding AdministratorStatus}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
  </DockPanel></Border>
 </Grid>
</Window>
